; Copy these settings into HSMMod.ini beside the game executable.
; Existing HSMMod.ini settings do not need to be replaced.
[net]
role=direct
name=Player
port=27015
upnp=1
connect=127.0.0.1:27015
reports=off
update_check=1
; HTTPS public IPv4 lookup for the host address label (LAN still works when off).
public_ip_lookup=1
; Optional override for the relay beta operator's HTTPS signalling hostname.
; relay_signalling_host=relay-signalling.example.org
